{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["users"],
  "properties": {
    "guidePart": { "type": "string", "enum": ["all", "inner", "outer"] },
    "users": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "prefix": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "explicitNames": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
        }
      }
    }
  }
}
